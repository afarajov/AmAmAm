{
  "name": "contextlayer",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "contextlayer",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.8.3"
      }
    },
    "apps/api": {
      "name": "@contextlayer/api",
      "version": "0.1.0",
      "dependencies": {
        "@contextlayer/shared": "0.1.0"
      }
    },
    "apps/extension": {
      "name": "@contextlayer/extension",
      "version": "0.1.0",
      "dependencies": {
        "@contextlayer/page-engine": "0.1.0",
        "@contextlayer/shared": "0.1.0"
      }
    },
    "apps/playground": {
      "name": "@contextlayer/playground",
      "version": "0.1.0",
      "dependencies": {
        "@contextlayer/page-engine": "0.1.0",
        "@contextlayer/shared": "0.1.0"
      }
    },
    "node_modules/@contextlayer/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@contextlayer/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@contextlayer/page-engine": {
      "resolved": "packages/page-engine",
      "link": true
    },
    "node_modules/@contextlayer/playground": {
      "resolved": "apps/playground",
      "link": true
    },
    "node_modules/@contextlayer/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/page-engine": {
      "name": "@contextlayer/page-engine",
      "version": "0.1.0",
      "dependencies": {
        "@contextlayer/shared": "0.1.0"
      }
    },
    "packages/shared": {
      "name": "@contextlayer/shared",
      "version": "0.1.0"
    }
  }
}
